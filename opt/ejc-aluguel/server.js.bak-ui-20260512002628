http.createServer(async (req, res) => {
  try {
    if (!verifySession(req)) return redirect(res, "/login?callbackUrl=/admin/aluguel");
    if (req.method === "POST") {
      const form = await body(req);
      if (form.get("intent") === "delete") {
        await prisma.$executeRawUnsafe("DELETE FROM Rental WHERE id=?", form.get("id"));
      } else {
        await prisma.$executeRawUnsafe(
          "INSERT INTO Rental (id,lenderName,rentedAt,dueAt,takenBy,description,createdAt,updatedAt) VALUES (?,?,?,?,?,?,NOW(),NOW())",
          "aluguel-" + Date.now().toString(36),
          form.get("lenderName"),
          new Date(form.get("rentedAt")),
          new Date(form.get("dueAt")),
          form.get("takenBy"),
          form.get("description"),
        );
      }
      await syncSheet();
      return redirect(res, "/admin/aluguel");
    }
    res.writeHead(200, { "content-type": "text/html; charset=utf-8", "cache-control": "no-store" });
    res.end(renderPage(await listRentals()));
  } catch (error) {
    console.error(error);
    res.writeHead(500);
    res.end("Erro no aluguel");
  }
}).listen(PORT, "127.0.0.1", () => console.log("EJC aluguel on " + PORT));
